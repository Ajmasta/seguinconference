---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../content/en/site.json';
import { url } from '../lib/url';
import cardiacScreen from '../assets/images/cardiac-screen.jpg';

// Prizes stay hidden until Finance and the POCUS Journal confirm (HANDOFF.md section 4).
// Set SHOW_PRIZES to true and write the confirmed wording below once approved.
const SHOW_PRIZES = false;

const glance = [
  { icon: 'users', label: 'Team', value: '1–4 students', text: 'Solo entries welcome. Teams can mix schools.' },
  { icon: 'book', label: 'Abstract', value: '350 words', text: 'Describe your school today, your project and how you would measure it.' },
  { icon: 'mic', label: 'Pitch', value: '7 minutes', text: 'Presented live with slides in a Zoom breakout room.' },
  { icon: 'star', label: 'Cost', value: 'Free', text: 'Open to students at any Canadian medical school.' },
] as const;
const dates = [
  { date: 'Dec 25, 2026', title: 'Team registration closes', text: 'Registered teams receive an upload link by email.' },
  { date: 'Jan 2, 2027', title: 'Abstract + slides due', text: 'One week before the conference. Exact time to be confirmed.' },
  { date: 'Jan 9, 2027', title: 'Present live', text: 'Teams pitch in breakout rooms; winners announced at the closing.', current: true },
];
const criteria = [
  { icon: 'target', title: 'Relevance', text: "A balanced, evidence-backed look at your school's current POCUS curriculum." },
  { icon: 'bulb', title: 'Innovation', text: 'An original solution that builds on strengths and fixes the gaps.' },
  { icon: 'check', title: 'Feasibility', text: 'A realistic plan: timeline, stakeholders, resources and challenges.' },
  { icon: 'star', title: 'Impact & scalability', text: 'Lasting improvement, and whether other schools could adopt it.' },
  { icon: 'chart', title: 'Evaluation strategy', text: 'Clear metrics that show whether the project worked.' },
] as const;
// One form registers people for the conference and the case competition.
const teamPh = site.registerUrlIsPlaceholder ? 'register-link' : undefined;
import { hasArchive } from '../lib/content';
---
<Base
  title="Case Competition · SCPEC 2027"
  description="Teams of 1 to 4 Canadian medical students pitch a plan to improve POCUS teaching at their school. 350-word abstract, 7-minute pitch. Team registration closes December 25, 2026."
  current="case-competition"
>
  <section style="background:#fff">
    <div class="container cc-hero">
      <div class="eyebrow">SCPEC 2027 case competition</div>
      <h1 class="display display-80" style="text-transform:uppercase;letter-spacing:0">Your idea.<br /><span class="blue">Better POCUS<br />education.</span></h1>
    </div>
  </section>
  <section class="theme-bar on-dark">
    <div class="container theme-inner">
      <div class="stack" style="flex:1 1 560px;min-width:0;gap:10px">
        <span class="label" style="color:var(--light-blue);letter-spacing:0.1em">2027 theme</span>
        <span class="head" style="font-size:clamp(22px,2.6vw,30px);line-height:1.25">{site.theme}</span>
      </div>
      <a class="btn btn-primary" href={site.registerUrl} data-placeholder={teamPh} style="padding:16px 28px">Register your team</a>
    </div>
  </section>

  <section class="container challenge">
    <div style="flex:1 1 340px;min-width:0">
      <h2 class="h2-40">The challenge</h2>
      <Image src={cardiacScreen} alt="A cardiac ultrasound image on a portable machine" class="ch-img" widths={[400, 700, 1000]} sizes="(max-width: 960px) 100vw, 380px" />
    </div>
    <div class="ch-text">
      <p><strong>Reflect</strong> on how POCUS is taught at your school today, with an honest, evidence-backed look at its strengths and gaps.</p>
      <p><strong>Refine</strong> what already works, and <strong>redesign</strong> what doesn't, with a realistic project your school could run.</p>
      <p>Then show how you would know it worked, and how other schools could adopt it.</p>
    </div>
  </section>

  <section class="container" style="padding-top:72px">
    <div class="glance">
      {glance.map((g) => (
        <div class="card glance-card">
          <span class="icon-tile"><Icon name={g.icon} /></span>
          <span class="label">{g.label}</span>
          <span class="head" style="font-size:24px">{g.value}</span>
          <span class="muted" style="font-size:15px;line-height:1.5">{g.text}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="dates on-dark band">
    <div class="container" style="padding-top:88px;padding-bottom:88px">
      <h2 class="h2-40" style="margin-bottom:40px">Key dates</h2>
      <ol class="timeline" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
        {dates.map((d) => (
          <li>
            <span class="head" style={`font-weight:800;font-size:28px;color:${d.current ? '#FFFFFF' : 'var(--light-blue)'}`}>{d.date}</span>
            <span style="font-weight:600;font-size:17px">{d.title}</span>
            <span style="font-size:15px;line-height:1.5;color:var(--on-dark)">{d.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container" style="padding-top:96px">
    <div class="judged-head">
      <h2 class="h2-40">How you're judged</h2>
      <span class="muted" style="font-size:16px">Each criterion is scored by several independent judges.</span>
    </div>
    <div class="criteria">
      {criteria.map((c, i) => (
        <div class="card crit">
          <span class="crit-top"><span class="head blue" style="font-size:15px">{String(i + 1).padStart(2, '0')}</span><span class="icon-tile icon-tile--sm"><Icon name={c.icon} /></span></span>
          <span class="head" style="font-size:20px">{c.title}</span>
          <span class="muted" style="font-size:15px;line-height:1.5">{c.text}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container" style="padding-top:96px">
    <div class="extras">
      {SHOW_PRIZES && (
        <div class="extra extra--pale">
          <span class="head" style="font-size:24px">Prizes &amp; publication</span>
          <span style="font-size:16px;line-height:1.6;color:var(--grey-dark)">[Confirmed prizes go here.]</span>
        </div>
      )}
      <div class="extra card">
        <span class="head" style="font-size:24px">What to submit</span>
        <ul class="submit-list">
          <li><strong>Abstract:</strong> up to 350 words.</li>
          <li><strong>Slide deck:</strong> for a 7-minute live pitch.</li>
          <li><strong>How:</strong> registered teams get an upload link by email. Both are due {dates[1].date}.</li>
        </ul>
        {/* Template buttons appear automatically once abstractTemplateUrl / slideTemplateUrl are set in site.json. */}
        {(site.abstractTemplateUrl || site.slideTemplateUrl) && (
          <span class="flex-wrap" style="gap:12px;padding-top:4px">
            {site.abstractTemplateUrl && <a class="btn btn-outline" href={site.abstractTemplateUrl} style="padding:12px 18px">Abstract template</a>}
            {site.slideTemplateUrl && <a class="btn btn-outline" href={site.slideTemplateUrl} style="padding:12px 18px">Slide template</a>}
          </span>
        )}
      </div>
    </div>
    <p class="muted" style="margin-top:24px;font-size:14px;line-height:1.6">With your consent at registration, your abstract and slides may be published {hasArchive ? <>in the <a href={url('/archive')}>SCPEC archive</a></> : 'on this website'} after the conference. Questions about the competition: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </section>

  <section class="container section-last" style="padding-top:96px">
    <div class="cta on-dark pad-56">
      <div class="stack" style="gap:10px;max-width:640px">
        <h2 class="h2-44" style="line-height:1.05">How would you improve POCUS at your school?</h2>
        <p style="font-size:17px;color:var(--on-blue)">One form registers you for the conference and the case competition. Registration closes {site.registrationCloses}.</p>
      </div>
      <a class="btn btn-white btn-lg" href={site.registerUrl} data-placeholder={teamPh} style="padding:18px 32px;border-radius:8px">Register your team</a>
    </div>
  </section>
</Base>

<style>
  .submit-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 16px; line-height: 1.6; color: var(--grey-dark); }
  .submit-list strong { color: var(--navy); }
  .cc-hero { padding-top: 88px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 24px; }
  .theme-bar { background: var(--navy); color: #fff; }
  .theme-inner { padding-top: 64px; padding-bottom: 64px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px; }
  .challenge { padding-top: 88px; display: flex; flex-wrap: wrap; gap: 64px; }
  .challenge :global(.ch-img) { display: block; width: 100%; height: 320px; object-fit: cover; object-position: 50% 35%; border-radius: 20px; margin-top: 28px; }
  .ch-text { flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 16px; font-size: 18px; line-height: 1.65; color: var(--grey-dark); }
  .ch-text strong { color: var(--navy); }
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .glance-card { padding: 28px; display: flex; flex-direction: column; gap: 8px; }
  .dates { background: var(--navy); color: #fff; }
  .judged-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 32px; }
  .criteria { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .crit { padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .crit-top { display: flex; justify-content: space-between; align-items: center; }
  .extras { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 24px; }
  .extra { border-radius: 16px; padding: 40px; display: flex; flex-direction: column; gap: 12px; }
  .extra--pale { background: var(--pale-blue); }
  .cta { background: var(--blue); color: #fff; border-radius: 24px; padding: 64px 56px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px; }
  @media (max-width: 720px) {
    .cc-hero { padding-top: 64px; padding-bottom: 48px; }
    .challenge { padding-top: 72px; gap: 32px; }
    .ch-text { font-size: 17px; }
    .extra { padding: 28px 24px; }
  }
</style>
