---
import '../styles/global.css';
import '../styles/motion.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import heroBeam from '../assets/images/hero-beam.jpg';

interface Props {
  title: string;
  description: string;
  current?: string;
  footer?: 'full' | 'simple';
  footerLastLink?: 'faq' | 'home';
}
const { title, description, current, footer = 'simple', footerLastLink = 'faq' } = Astro.props;

const og = await getImage({ src: heroBeam, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" sizes="64x64" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />
  <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
  <meta name="theme-color" content="#0B1F3A" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SCPEC" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
  <meta property="og:image:height" content={String(og.attributes.height ?? 625)} />
  <meta property="og:locale" content="en_CA" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    document.documentElement.classList.add('js');
    // Safety net: if the motion script never runs, show everything instead of leaving blocks hidden.
    setTimeout(function () { if (!window.__motion) document.documentElement.classList.add('motion-fallback'); }, 2500);
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header current={current} />
  <main id="main">
    <slot />
  </main>
  <Footer variant={footer} lastLink={footerLastLink} />
  <script>import '../scripts/motion';</script>
</body>
</html>
